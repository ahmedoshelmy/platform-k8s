# Settings read by scripts/up.sh, smoke.sh and down.sh. No secrets: the charts' dev values use placeholders.
# Folder holding the listmate/ and trip-split/ checkouts.
APPS_DIR=..
# 1 = docker build the app images first, 0 = use local images tagged localhost/<app>-<tier>:dev.
BUILD=1
# kind cluster name.
CLUSTER=platform
# Uncomment for rootless podman instead of Docker.
# KIND_EXPERIMENTAL_PROVIDER=podman
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
